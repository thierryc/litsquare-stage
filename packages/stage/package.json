{
  "name": "@litsquare/stage",
  "version": "0.1.1",
  "description": "Host-agnostic LitSquare Stage frame runner",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "litsquare",
    "stage",
    "animation",
    "video",
    "frame-rendering",
    "typescript",
    "runner"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/thierryc/litsquare-stage.git",
    "directory": "packages/stage"
  },
  "bugs": {
    "url": "https://github.com/thierryc/litsquare-stage/issues"
  },
  "homepage": "https://github.com/thierryc/litsquare-stage#readme",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm run build",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
