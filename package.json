{
  "name": "litsquare-stage-workspace",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter './packages/*' -r build",
    "build:examples": "pnpm build && pnpm --filter './examples/*' -r build",
    "check": "pnpm --filter @litsquare/stage build && pnpm --filter @litsquare/stage-protocol build && pnpm --filter './packages/*' -r check",
    "test": "pnpm --filter './packages/*' -r test"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "overrides": {
      "why-is-node-running": "3.2.2"
    }
  }
}
